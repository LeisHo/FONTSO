.DS_Store
Thumbs.db
*.log
node_modules/

# Scraped/dumped/regenerable inputs, per the workspace CLAUDE.md §11
# folder convention. data/processed/ is deliberately NOT ignored — the
# dev-panel settings log and the UI layout config live there and are meant
# to be tracked (§12l).
data/raw/

# Local screen recordings (bug-report clips etc.) — never meant to be
# tracked; a blanket `git add -A` once swept one into a commit on a sibling
# project before it was caught.
datalog/

# Font binaries are not committed. Two reasons, both real: licensing
# (lab/test-fonts holds OS faces that are not redistributable, and
# data/Fonts includes at least one explicitly-DEMO face plus commercial
# CJK families) and size (data/Fonts alone is 8.5MB, which git would
# carry forever). The manifests and the discovery endpoint ARE tracked,
# so the picker works for anyone who supplies their own files.
#
# To commit them anyway -- a private repo makes this a personal backup
# rather than redistribution -- delete the data/Fonts lines below.
lab/test-fonts/*.ttf
lab/test-fonts/*.otf
lab/test-fonts/*.woff
data/Fonts/*.ttf
data/Fonts/*.TTF
data/Fonts/*.otf
data/Fonts/*.OTF
data/Fonts/*.woff
data/Fonts/*.ttc

# npm is used only to fetch opentype.js, which is then vendored into
# lab/lib/. No build step, no runtime dependency on node_modules.
node_modules/
package-lock.json
